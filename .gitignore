# Host-specific configuration (copy config.sh.example -> config.sh)
config.sh

# Inputs that are fetched or extracted, never vendored
*.iso
iso/
tools/
build/
http/winpe/
http/tools/
http/images/
http/drivers/
http/updates/
http/winpe-drivers/*
!http/winpe-drivers/README.md
pxe/

# Which machines may be deployed, and per-model defaults, are site-specific
# (see http/machines/README.md and http/models/README.md)
http/machines/*.cfg
http/models/*.cfg

# Runtime state
run/
vms/
http/uploads/
*.qcow2
*.log
__pycache__/

# Editor / agent settings
.claude/
http/post/winget/
http/post/openssh/
# lab SSH keys, written by bin/fetch-tools openssh (or keys) into every role that wants them
http/roles/*/authorized_keys
http/roles/*/*.pub
http/cmd/
http/boot/
http/collector/

# Evidence kept in spikes/ is tracked even when it is a log
!spikes/**/*.log
spikes/2026-10-25-reboot-hang/layout/*.bin.gz
spikes/2026-10-25-reboot-hang/smoke-rerun-[2-8]/
# the OVMF 2024.11 control runs (9-12): keep the report, the log and boot.out (which
# firmware QEMU was given), not the 5 MB of shots and console frames each
spikes/2026-10-25-reboot-hang/smoke-rerun-9/*
spikes/2026-10-25-reboot-hang/smoke-rerun-1[0-2]/*
!spikes/2026-10-25-reboot-hang/smoke-rerun-9/report.md
!spikes/2026-10-25-reboot-hang/smoke-rerun-9/smoke.log
!spikes/2026-10-25-reboot-hang/smoke-rerun-9/boot.out
!spikes/2026-10-25-reboot-hang/smoke-rerun-1[0-2]/report.md
!spikes/2026-10-25-reboot-hang/smoke-rerun-1[0-2]/smoke.log
!spikes/2026-10-25-reboot-hang/smoke-rerun-1[0-2]/boot.out
# the self-built OVMF 2025.11 bisection runs (ovmf-nocache/): same three files kept
spikes/2026-10-25-reboot-hang/smoke-nocache-[0-9]/*
spikes/2026-10-25-reboot-hang/smoke-stock-[0-9]/*
!spikes/2026-10-25-reboot-hang/smoke-nocache-[0-9]/report.md
!spikes/2026-10-25-reboot-hang/smoke-nocache-[0-9]/smoke.log
!spikes/2026-10-25-reboot-hang/smoke-nocache-[0-9]/boot.out
!spikes/2026-10-25-reboot-hang/smoke-stock-[0-9]/report.md
!spikes/2026-10-25-reboot-hang/smoke-stock-[0-9]/smoke.log
!spikes/2026-10-25-reboot-hang/smoke-stock-[0-9]/boot.out
# reruns 3, 5 and 6 caught hangs: kept, memory dumps gzipped (rerun 6's 80 MB dump stays local)
!spikes/2026-10-25-reboot-hang/smoke-rerun-3/
!spikes/2026-10-25-reboot-hang/smoke-rerun-5/
!spikes/2026-10-25-reboot-hang/smoke-rerun-6/
spikes/2026-10-25-reboot-hang/smoke-rerun-[356]/*.bin
# smoke-stock-3 (2026-10-27): the self-built stock firmware's recorded hang, kept whole like reruns 3/5/6, minus the 80 MB dump
!spikes/2026-10-25-reboot-hang/smoke-stock-3/*
spikes/2026-10-25-reboot-hang/smoke-stock-3/*.bin
spikes/2026-10-25-reboot-hang/smoke-stock-3/*-bsp-*.bin.gz
spikes/2026-10-25-reboot-hang/smoke-rerun-6/*-bsp-*.bin.gz
spikes/2026-10-25-reboot-hang/*.stdout
