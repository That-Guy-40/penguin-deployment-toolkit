#!/bin/bash
# vm-create - create a lab VM: an empty disk, UEFI variables, a fixed identity,
# and (unless --mode none) its entry in http/machines/.
#
#   vm-create <name> [--mode deploy|shell|none] [--image <name>] [--drivers <pack>]
#                    [--reference] [--net user|bridge:<br>]
#
#   --mode deploy  (default) machines/<uuid>.cfg says MODE=deploy: the task
#                  sequence will wipe and install THIS VM's (new, empty) disk
#   --mode shell   listed, but the task sequence stops at a prompt
#   --mode none    no machines/ entry at all: behaves like an unknown machine
#   --image <name> deploy http/images/<name>.wim instead of base.wim
#   --nic <model>  e1000e (default; WinPE drives it inbox) or virtio-net-pci
#   --disk <bus>   ahci (default; inbox) or virtio. The virtio choices need
#                  bin/fetch-tools virtio (WinPE-side drivers) and --drivers virtio-w11
#   --vars <file>  UEFI variable template for this VM (default: config.sh's;
#                  e.g. /usr/share/OVMF/OVMF_VARS_4M.ms.fd = Secure Boot enforcing)
#   --reference    a reference machine: after first logon it generalizes itself
#                  (sysprep) and shuts down, ready to be captured (MODE=capture)
#
# Every VM gets its own SMBIOS UUID and MAC. QEMU's default UUID is all zeros,
# which would make every VM the same machine to the server.
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
need qemu-img uuidgen ss

NAME="" MODE="deploy" DRIVERS="" NET="user" IMAGE="base" REFERENCE=0 NIC="e1000e" DISK="ahci" VARS=""
while (( $# )); do
    case "$1" in
        --mode)    MODE="${2:?}"; shift 2 ;;
        --drivers) DRIVERS="${2:?}"; shift 2 ;;
        --image)   IMAGE="${2:?}"; IMAGE="${IMAGE%.wim}"; shift 2 ;;
        --reference) REFERENCE=1; shift ;;
        --nic)     NIC="${2:?}"; shift 2 ;;
        --disk)    DISK="${2:?}"; shift 2 ;;
        --vars)    VARS="${2:?}"; shift 2 ;;
        --net)     NET="${2:?}"; shift 2 ;;
        -h|--help) sed -n '2,24p' "$0"; exit 0 ;;
        -*) die "unknown option: $1" ;;
        *)  [[ -z "$NAME" ]] || die "one VM name only"; NAME="$1"; shift ;;
    esac
done
[[ "$NAME" =~ ^[A-Za-z0-9_-]+$ ]] || die "usage: vm-create <name> [options]   (name: letters, digits, _ and -)"
[[ "$MODE" =~ ^(deploy|shell|none)$ ]] || die "--mode must be deploy, shell or none"
[[ "$NET" == user || "$NET" == bridge:* ]] || die "--net must be 'user' or 'bridge:<bridge-name>'"
[[ "$NIC" =~ ^(e1000e|virtio-net-pci)$ ]] || die "--nic must be e1000e or virtio-net-pci"
[[ "$DISK" =~ ^(ahci|virtio)$ ]] || die "--disk must be ahci or virtio"
VARS="${VARS:-${OVMF_VARS_TEMPLATE:?}}"
[[ -f "$VARS" ]] || die "UEFI vars template not found: $VARS"

VM_DIR="$VMS_DIR/$NAME"
[[ ! -e "$VM_DIR" ]] || die "VM '$NAME' already exists ($VM_DIR). Remove it with: bin/teardown --purge-vm $NAME"

UUID="$(uuidgen | tr 'A-Z' 'a-z')"
MAC="$(printf '52:54:00:%02x:%02x:%02x' $((RANDOM % 256)) $((RANDOM % 256)) $((RANDOM % 256)))"
# First monitor port from 7001 that no existing VM claims and nothing listens on.
PORT=7001
listeners="$(ss -tln 2>/dev/null)"
while grep -qs "VM_MONITOR_PORT=$PORT\$" "$VMS_DIR"/*/vm.conf 2>/dev/null || grep -q ":$PORT " <<<"$listeners"; do
    PORT=$((PORT + 1))
done

mkdir -p "$VM_DIR"
qemu-img create -q -f qcow2 "$VM_DIR/disk.qcow2" "${VM_DISK_SIZE:-64G}"
cp "$VARS" "$VM_DIR/vars.fd"
cat > "$VM_DIR/vm.conf" <<CONF
# Lab VM "$NAME", created $(date -Is) by bin/vm-create.
VM_NAME=$NAME
VM_UUID=$UUID
VM_MAC=$MAC
VM_MONITOR_PORT=$PORT
VM_MEMORY=${VM_MEMORY:-4G}
VM_CPUS=${VM_CPUS:-4}
VM_NIC=$NIC
VM_DISK=$DISK
VM_NET=$NET
VM_VARS_TEMPLATE=$VARS
CONF

if [[ "$MODE" != none ]]; then
    mkdir -p "$HTTP_DIR/machines"
    {
        echo "# lab VM $NAME (bin/vm-create, $(date -I))"
        echo "MODE=$MODE"
        echo "IMAGE=$IMAGE.wim"
        echo "UNATTEND=default.xml"
        [[ -z "$DRIVERS" ]] || echo "DRIVERS=$DRIVERS"
        (( ! REFERENCE )) || echo "REFERENCE=yes"
    } > "$HTTP_DIR/machines/$UUID.cfg"
fi

info "created VM $NAME"
info "  uuid $UUID   mac $MAC   monitor 127.0.0.1:$PORT"
info "  disk ${VM_DISK_SIZE:-64G}   net $NET   machines entry: $([[ $MODE == none ]] && echo none || echo "MODE=$MODE")"
info "next: bin/vm-boot $NAME"
