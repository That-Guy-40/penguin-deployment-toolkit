#!/usr/bin/env python3
"""status - who has booted, and where each machine is in its install.

  status                 one row per machine: last event, age, mode, product
  status --watch         the same, refreshed every 2 s
  status <id|vm-name>    every event of that machine's latest boot, with timings

Read-only over run/beacons.log and run/access.log. A row whose last event is
ev=fail is marked FAIL; one stuck on ev=start for more than --stale minutes
(default 10) is marked STUCK?: that step began and nothing has been heard since.
"""
import argparse
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _pdt


def table(stale_min):
    events = _pdt.all_events()
    names = _pdt.vm_names()
    now = time.time()
    by_id = {}
    for e in events:
        by_id.setdefault(e["id"], []).append(e)
    rows = []
    for mid, evs in by_id.items():
        last = evs[-1]
        product = next((e["product"] for e in reversed(evs) if e.get("product")), "")
        mode = next((e["mode"] for e in reversed(evs) if e.get("mode")), "")
        flag = ""
        if last["ev"] == "fail":
            flag = "FAIL"
        elif last["ev"] == "start" and now - last["t"] > stale_min * 60:
            flag = "STUCK?"
        detail = " ".join(f"{k}={last[k]}" for k in ("rc", "msg") if last.get(k))
        rows.append((last["t"], [mid, names.get(mid, ""), f'{last["step"]} {last["ev"]}', _pdt.age(now - last["t"]),
                                 flag, mode, last.get("run", ""), product, detail]))
    rows.sort(key=lambda r: -r[0])
    head = ["ID", "VM", "LAST EVENT", "AGE", "", "MODE", "RUN", "PRODUCT", "DETAIL"]
    body = [r[1] for r in rows]
    if not body:
        return "no events yet (run/beacons.log and run/access.log are empty)"
    widths = [max(len(str(x[i])) for x in [head] + body) for i in range(len(head))]
    return "\n".join("  ".join(str(c).ljust(w) for c, w in zip(r, widths)).rstrip() for r in [head] + body)


def detail(arg):
    events = _pdt.all_events()
    mid = _pdt.resolve_id(arg, events)
    evs = [e for e in events if e["id"] == mid]
    if not evs:
        _pdt.die(f"no events for {mid}")
    # latest boot = everything from the last 'ipxe' event (or the last run's first event) on
    start = max((i for i, e in enumerate(evs) if e["step"] == "ipxe"), default=None)
    if start is None:
        run = evs[-1]["run"]
        start = next(i for i, e in enumerate(evs) if e["run"] == run)
    evs = evs[start:]
    print(f"{mid}  {_pdt.vm_names().get(mid, '')}")
    t0 = prev = evs[0]["t"]
    for e in evs:
        extra = " ".join(f"{k}={e[k]}" for k in ("mode", "product", "mac", "host", "rc", "msg") if e.get(k))
        print(f'  {e["iso"]}  +{e["t"] - t0:7.1f}s  (+{e["t"] - prev:6.1f}s)  {e["step"]:<11} {e["ev"]:<5} {extra}')
        prev = e["t"]


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("id", nargs="?", help="a machine id (UUID or unique prefix) or lab VM name")
    ap.add_argument("--watch", action="store_true")
    ap.add_argument("--stale", type=float, default=10, metavar="MIN")
    a = ap.parse_args()
    if a.id:
        return detail(a.id)
    if not a.watch:
        return print(table(a.stale))
    try:
        while True:
            sys.stdout.write("\033[2J\033[H" + time.strftime("%H:%M:%S") + "\n" + table(a.stale) + "\n")
            sys.stdout.flush()
            time.sleep(2)
    except KeyboardInterrupt:
        pass


main()
