#!/bin/bash
# teardown - stop what this project started; optionally delete lab state.
#
#   teardown                  stop every lab VM, our nginx, our dnsmasq (nothing is deleted)
#   teardown --purge-vm <vm>  stop and DELETE one lab VM (disk, NVRAM) and its machines/ entry
#   teardown --purge          stop everything, then delete ALL lab VMs, run/ and uploads
#   --yes                     do not ask before deleting
#
# Never touched: the ISO, http/winpe, http/images, http/tools, pxe/ipxe.efi, build/.
# Processes are stopped by the PIDs in our own pid files, never by name.
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

PURGE=0 PURGE_VM="" YES=0
while (( $# )); do
    case "$1" in
        --purge)    PURGE=1; shift ;;
        --purge-vm) PURGE_VM="${2:?}"; shift 2 ;;
        --yes|-y)   YES=1; shift ;;
        -h|--help)  sed -n '2,10p' "$0"; exit 0 ;;
        *) die "unknown argument: $1 (try --help)" ;;
    esac
done

confirm() {
    (( YES )) && return 0
    [[ -t 0 ]] || die "$1  -- no terminal to ask on; pass --yes"
    read -rp "$1 (y/N) " reply
    [[ "$reply" =~ ^[Yy]$ ]] || { info "cancelled"; exit 0; }
}

delete_vm() {
    local name="$1" uuid
    vm_load "$name"
    "$PDT_ROOT/bin/vm-stop" "$name" --force
    uuid="$VM_UUID"
    rm -rf "${VMS_DIR:?}/$name"
    rm -f "$HTTP_DIR/machines/$uuid.cfg"
    info "deleted VM $name (and machines/$uuid.cfg)"
}

if [[ -n "$PURGE_VM" ]]; then
    [[ -f "$VMS_DIR/$PURGE_VM/vm.conf" ]] || die "no such VM: $PURGE_VM"
    confirm "Delete lab VM $PURGE_VM, its disk and its machines/ entry?"
    delete_vm "$PURGE_VM"
    exit 0
fi

shopt -s nullglob
for conf in "$VMS_DIR"/*/vm.conf; do
    "$PDT_ROOT/bin/vm-stop" "$(basename "$(dirname "$conf")")" --force
done
"$PDT_ROOT/bin/serve" stop
"$PDT_ROOT/bin/pxe-lan" stop || true

if (( PURGE )); then
    confirm "Delete ALL lab VMs under vms/, run/ (logs, beacons) and http/uploads/?"
    for conf in "$VMS_DIR"/*/vm.conf; do delete_vm "$(basename "$(dirname "$conf")")"; done
    rm -rf "${STATE_DIR:?}" "${HTTP_DIR:?}/uploads"
    info "purged. Kept: ISO, http/winpe, http/images, http/tools, pxe/ipxe.efi, build/."
fi
