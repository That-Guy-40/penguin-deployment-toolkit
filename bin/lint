#!/usr/bin/env python3
"""lint - catch, before any machine boots, what would otherwise be a 404 three
minutes into an install.

  lint            check http/ and the host set-up; exit 1 if anything FAILs
  lint --deep     also re-hash images against their sidecars (slow)
  lint --selftest only run the self-test

Every row is PASS, FAIL or UNKNOWN. UNKNOWN means "could not be checked" and is
never counted as a pass. Because a checker that reports all-PASS looks exactly
like one that checks nothing, every run first breaks a copy of the task
sequence in known ways and requires each defect to be reported; if that
self-test does not bite, lint itself fails.

What is checked:
  boot.ipxe      every kernel/initrd path exists under http/
  task sequence  every %SRV%/... path in ts/*.cmd and post/*.cmd exists; every
                 X:\\Windows\\System32 file it runs is one boot.ipxe injects
  line endings   files Windows executes are CRLF
  machines/*.cfg (and the defaults in deploy.cmd): MODE valid; image present
                 with a matching sidecar; unattend well-formed; diskpart script
                 and driver pack present, the pack containing an .inf
  host           pinned third-party binaries, pxe/ipxe.efi matching config.sh,
                 boot.wim free of a winpeshl.ini, the server answering
"""
import argparse
import glob
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import xml.dom.minidom

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _pdt

# Paths that exist only as nginx locations (bin/serve), not as files.
VIRTUAL = ("ts/id.cmd", "beacon", "health")
VIRTUAL_PREFIX = ("uploads/",)
CFG_KEYS = ("MODE", "IMAGE", "UNATTEND", "DRIVERS", "DISKPART")
MODES = ("deploy", "capture", "shell")
# Programs the task sequence may call from System32 that stock WinPE ships.
INBOX = {"cmd.exe"}
CRLF_GLOBS = ("ts/*.cmd", "ts/*.ini", "ts/diskpart/*.txt", "post/*.cmd")


class Rows:
    def __init__(self):
        self.rows = []

    def add(self, verdict, what, detail=""):
        if (verdict, what, detail) not in self.rows:  # the same reference may occur twice in a script
            self.rows.append((verdict, what, detail))

    def ok(self, what, detail=""):
        self.add("PASS", what, detail)

    def fail(self, what, detail=""):
        self.add("FAIL", what, detail)

    def unknown(self, what, detail=""):
        self.add("UNKNOWN", what, detail)

    def count(self, verdict):
        return sum(1 for r in self.rows if r[0] == verdict)

    def show(self):
        for verdict, what, detail in self.rows:
            print(f"{verdict:<8} {what}" + (f": {detail}" if detail else ""))


def is_virtual(path):
    return path in VIRTUAL or path.startswith(VIRTUAL_PREFIX)


def read(path):
    with open(path, newline="", errors="replace") as f:
        return f.read()


def ipxe_refs(text):
    """(command, url, injected-name) for each kernel/initrd/chain line of an iPXE script."""
    out = []
    for line in text.splitlines():
        line = line.split("||")[0].strip()
        tok = line.split()
        if not tok or tok[0] not in ("kernel", "initrd", "chain", "imgfetch"):
            continue
        name, url, i = None, None, 1
        while i < len(tok):
            if tok[i] in ("--name", "-n") and i + 1 < len(tok):
                name = tok[i + 1]
                i += 2
            elif tok[i].startswith("-"):
                i += 1
            else:
                url = tok[i]
                break
        if url:
            out.append((tok[0], url, name or os.path.basename(url.split("?")[0])))
    return out


def cfg_values(path):
    vals = {}
    for line in read(path).splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            k, v = line.split("=", 1)
            vals[k.strip().upper()] = v.split("#")[0].strip()
    return vals


def lint_tree(http, deep=False):
    """Checks that depend only on the files under http/."""
    R = Rows()
    rel = lambda p: os.path.relpath(p, http)
    exists = lambda p: os.path.isfile(os.path.join(http, p))

    # --- boot.ipxe ---------------------------------------------------------
    injected = set()
    boot = os.path.join(http, "boot.ipxe")
    if not os.path.isfile(boot):
        R.fail("boot.ipxe", "missing")
    else:
        for cmd, url, name in ipxe_refs(read(boot)):
            path = url.split("?")[0]
            if cmd in ("kernel", "initrd"):
                injected.add(name.lower())
            if "://" in url or "${" in path:
                R.unknown(f"boot.ipxe -> {url}", "not a static relative path; cannot check")
            elif is_virtual(path):
                R.ok(f"boot.ipxe -> {path}", "generated by bin/serve")
            elif exists(path):
                R.ok(f"boot.ipxe -> {path}")
            else:
                R.fail(f"boot.ipxe -> {path}", "file does not exist under http/")

    # --- task sequence: URLs and injected programs --------------------------
    scripts = sorted(glob.glob(os.path.join(http, "ts", "*.cmd")) + glob.glob(os.path.join(http, "post", "*.cmd")))
    defaults = {}
    for script in scripts:
        text = read(script)
        # "%SRV%/%%~u" inside "for %%u in (a b c) do": check each item of the list instead.
        refs = []
        for m in re.finditer(r"%SRV%/([^\s\"]+)", text):
            loop = re.fullmatch(r"%%~?(\w)", m.group(1))
            lists = re.findall(r"(?i)for %%" + loop.group(1) + r" in \(([^)]*)\)", text[:m.start()]) if loop else []
            if lists:
                refs += [item.strip('"') for item in lists[-1].split()]
            else:
                refs.append(m.group(1))
        for ref in refs:
            path = ref.split("?")[0]
            where = f"{rel(script)} -> {path}"
            if is_virtual(path):
                R.ok(where, "generated by bin/serve")
            elif "%" in path or "!" in path:
                var = re.search(r"[%!](\w+)[%!]", path)
                if var and (var.group(1).upper() in CFG_KEYS or var.group(1).upper() == "ID"):
                    continue  # resolved per machine below
                R.unknown(where, "contains a variable lint does not resolve")
            elif exists(path):
                R.ok(where)
            else:
                R.fail(where, "file does not exist under http/")
        if rel(script).startswith("ts" + os.sep):
            for m in re.finditer(r"(?i)System32\\([\w.-]+\.(?:cmd|exe|js|vbs|dll))", text):
                prog = m.group(1).lower()
                if prog in injected or prog in INBOX:
                    R.ok(f"{rel(script)} runs System32\\{m.group(1)}", "injected by boot.ipxe" if prog in injected else "inbox")
                else:
                    R.fail(f"{rel(script)} runs System32\\{m.group(1)}", "boot.ipxe does not inject it (no initrd --name)")
            for m in re.finditer(r"(?im)^set (%s)=(.*?)\r?$" % "|".join(CFG_KEYS), text):
                defaults.setdefault(m.group(1).upper(), m.group(2).strip())

    ini = os.path.join(http, "ts", "winpeshl.ini")
    if os.path.isfile(ini):
        for m in re.finditer(r"(?i)System32\\([\w.-]+\.(?:cmd|exe))", read(ini)):
            prog = m.group(1).lower()
            if prog in injected or prog in INBOX:
                R.ok(f"ts/winpeshl.ini starts System32\\{m.group(1)}")
            else:
                R.fail(f"ts/winpeshl.ini starts System32\\{m.group(1)}", "boot.ipxe does not inject it")

    # --- line endings ------------------------------------------------------
    for pattern in CRLF_GLOBS:
        for f in sorted(glob.glob(os.path.join(http, pattern))):
            data = open(f, "rb").read()
            bare = len(re.findall(rb"(?<!\r)\n", data))
            if bare:
                R.fail(f"{rel(f)} line endings", f"{bare} line(s) end in LF, Windows needs CRLF")
            else:
                R.ok(f"{rel(f)} line endings", "CRLF")

    # --- machines: the defaults, then every cfg ----------------------------
    machines = [("defaults in ts/deploy.cmd", dict(defaults))]
    for f in sorted(glob.glob(os.path.join(http, "machines", "*.cfg"))):
        stem = os.path.basename(f)[:-4]
        if not _pdt.UUID_RE.match(stem):
            R.fail(f"machines/{os.path.basename(f)}", "file name is not a lowercase SMBIOS UUID; the task sequence will never fetch it")
            continue
        machines.append((f"machines/{os.path.basename(f)}", {**defaults, **cfg_values(f)}))

    checked = {}
    for who, v in machines:
        mode = v.get("MODE", "")
        if mode.lower() in MODES:
            R.ok(f"{who} MODE={mode}")
        else:
            R.fail(f"{who} MODE={mode}", f"must be one of {', '.join(MODES)}")
        for key, sub, required in (("IMAGE", "images", True), ("UNATTEND", "unattend", True),
                                   ("DISKPART", "ts/diskpart", True), ("DRIVERS", "drivers", False)):
            val = v.get(key, "")
            if not val:
                if required:
                    R.fail(f"{who} {key}", "not set")
                continue
            path = f"{sub}/{val}" + (".wim" if key == "DRIVERS" else "")
            if (key, path) in checked:
                if checked[(key, path)]:
                    R.fail(f"{who} {key}={val}", checked[(key, path)])
                continue
            problem = check_asset(http, key, path, deep)
            checked[(key, path)] = problem
            if problem:
                R.fail(f"{who} {key}={val}", problem)
            else:
                R.ok(f"{who} {key}={val}", path)
    return R


def check_asset(http, key, path, deep):
    """Return a problem string, or '' if the asset a machine refers to is sound."""
    full = os.path.join(http, path)
    if not os.path.isfile(full):
        return f"http/{path} does not exist"
    if key == "UNATTEND":
        try:
            xml.dom.minidom.parse(full)
        except Exception as e:  # noqa: BLE001 - any parse error is the finding
            return f"http/{path} is not well-formed XML ({e})"
    if key in ("IMAGE", "DRIVERS"):
        sidecar = full[:-4] + ".json"
        if not os.path.isfile(sidecar):
            return f"http/{path} has no sidecar {os.path.basename(sidecar)} (made by bin/stage-image / bin/pack-drivers)"
        try:
            meta = json.load(open(sidecar))
        except Exception as e:  # noqa: BLE001
            return f"sidecar {os.path.basename(sidecar)} does not parse ({e})"
        if meta.get("size") != os.path.getsize(full):
            return f"http/{path} is {os.path.getsize(full)} bytes but its sidecar describes a {meta.get('size')}-byte file"
        if key == "DRIVERS" and not meta.get("infs"):
            return f"driver pack http/{path} lists no .inf files"
        if deep and meta.get("sha256"):
            h = hashlib.sha256()
            with open(full, "rb") as f:
                for chunk in iter(lambda: f.read(1 << 22), b""):
                    h.update(chunk)
            if h.hexdigest() != meta["sha256"]:
                return f"http/{path} does not match the SHA-256 in its sidecar"
    return ""


def lint_host():
    """Checks that involve this host: pins, ipxe.efi, boot.wim, the running server."""
    R = Rows()
    p = _pdt.paths()
    http = p["HTTP_DIR"]

    r = subprocess.run([os.path.join(_pdt.ROOT, "bin", "fetch-tools"), "check"], capture_output=True, text=True)
    for line in r.stdout.splitlines():
        verdict, _, rest = line.partition(" ")
        if verdict in ("PASS", "FAIL"):
            R.add(verdict, rest.strip())
    if r.returncode not in (0, 1) or not r.stdout.strip():
        R.unknown("pinned third-party binaries", f"bin/fetch-tools check did not run ({r.stderr.strip()[:80]})")

    efi = os.path.join(p["PXE_DIR"], "ipxe.efi")
    want = f'chain {p["BASE_URL"]}/boot.ipxe?'.encode()
    if not os.path.isfile(efi):
        R.fail("pxe/ipxe.efi", "missing (run bin/build-ipxe)")
    elif want in open(efi, "rb").read():
        R.ok("pxe/ipxe.efi chains to the server in config.sh", p["BASE_URL"])
    else:
        R.fail("pxe/ipxe.efi", f'does not chain to {p["BASE_URL"]}; config.sh changed since it was built (run bin/build-ipxe)')

    wim = os.path.join(http, "winpe", "boot.wim")
    if os.path.isfile(wim):
        info = subprocess.run(["wimlib-imagex", "info", wim], capture_output=True, text=True)
        idx = re.search(r"^Boot Index:\s*(\d+)", info.stdout, re.M)
        if info.returncode != 0 or not idx or idx.group(1) == "0":
            R.fail("winpe/boot.wim", "not a bootable WIM (no Boot Index)")
        else:
            listing = subprocess.run(["wimlib-imagex", "dir", wim, idx.group(1)], capture_output=True, text=True)
            if listing.returncode != 0:
                R.unknown("winpe/boot.wim is pristine", "wimlib-imagex dir failed")
            elif re.search(r"(?im)^/Windows/System32/winpeshl\.ini$", listing.stdout):
                R.fail("winpe/boot.wim is pristine", "the boot image already contains winpeshl.ini; wimboot's injected copy would collide (run bin/stage-winpe)")
            else:
                R.ok("winpe/boot.wim is pristine", f"boot image {idx.group(1)} has no winpeshl.ini of its own")

    url = f'http://{p["HTTP_BIND"] or "127.0.0.1"}:{p["HTTP_PORT"]}'
    r = subprocess.run(["curl", "-fsS", "--max-time", "3", f"{url}/health"], capture_output=True, text=True)
    if r.returncode != 0:
        R.unknown("server", f"nothing answers on {url} (bin/serve not running); live checks skipped")
    else:
        code = subprocess.run(["curl", "-s", "-o", "/dev/null", "-w", "%{http_code}", "--max-time", "5", f"{url}/boot.ipxe"],
                              capture_output=True, text=True).stdout
        (R.ok if code == "200" else R.fail)("server serves /boot.ipxe", f"HTTP {code}")
    return R


def selftest():
    """Break a copy of the task sequence in known ways; every defect must be reported."""
    src = _pdt.paths()["HTTP_DIR"]
    tmp = tempfile.mkdtemp(prefix="pdt-lint-")
    try:
        def fresh():
            d = os.path.join(tmp, "http")
            shutil.rmtree(d, ignore_errors=True)
            os.makedirs(d)
            shutil.copy(os.path.join(src, "boot.ipxe"), d)
            for sub in ("ts", "post", "unattend"):
                shutil.copytree(os.path.join(src, sub), os.path.join(d, sub))
            for sub in ("winpe", "tools", "images", "machines", "drivers"):
                os.makedirs(os.path.join(d, sub))
            for _cmd, url, _name in ipxe_refs(read(os.path.join(d, "boot.ipxe"))):
                path = url.split("?")[0]
                if not is_virtual(path) and not os.path.exists(os.path.join(d, path)):
                    open(os.path.join(d, path), "w").write("x")
            open(os.path.join(d, "images", "base.wim"), "w").write("image")
            json.dump({"size": 5}, open(os.path.join(d, "images", "base.json"), "w"))
            open(os.path.join(d, "machines", "11111111-2222-3333-4444-555555555555.cfg"), "w").write("MODE=deploy\n")
            return d

        def cfg(d, text):
            open(os.path.join(d, "machines", "11111111-2222-3333-4444-555555555555.cfg"), "w").write(text)

        def to_lf(p):
            data = open(p, "rb").read()  # read fully BEFORE reopening for write
            assert b"\r\n" in data
            open(p, "wb").write(data.replace(b"\r\n", b"\n"))

        def drop_line(d, f, needle):
            p = os.path.join(d, f)
            open(p, "w", newline="").write("".join(l for l in read(p).splitlines(True) if needle not in l))

        defects = [
            ("a file boot.ipxe loads is missing", lambda d: os.remove(os.path.join(d, "tools", "curl.exe")), "tools/curl.exe"),
            ("deploy.cmd saved with LF line endings", lambda d: to_lf(os.path.join(d, "ts", "deploy.cmd")), "line endings"),
            ("a machine names an image that does not exist", lambda d: cfg(d, "MODE=deploy\nIMAGE=nope.wim\n"), "IMAGE=nope.wim"),
            ("an image has lost its sidecar", lambda d: os.remove(os.path.join(d, "images", "base.json")), "sidecar"),
            ("an image no longer matches its sidecar", lambda d: open(os.path.join(d, "images", "base.wim"), "w").write("changed image"), "sidecar describes"),
            ("the unattend file is not well-formed", lambda d: open(os.path.join(d, "unattend", "default.xml"), "a").write("<oops>"), "well-formed"),
            ("a machine has an invalid MODE", lambda d: cfg(d, "MODE=wipe\n"), "MODE=wipe"),
            ("a machine names a driver pack that does not exist", lambda d: cfg(d, "MODE=deploy\nDRIVERS=ghost\n"), "DRIVERS=ghost"),
            ("boot.ipxe stops injecting id.cmd", lambda d: drop_line(d, "boot.ipxe", "--name id.cmd"), "id.cmd"),
            ("a script a deployed machine downloads is missing", lambda d: os.remove(os.path.join(d, "post", "firstlogon.cmd")), "post/firstlogon.cmd"),
            ("a cfg file is not named by a UUID", lambda d: open(os.path.join(d, "machines", "my-pc.cfg"), "w").write("MODE=deploy\n"), "my-pc.cfg"),
        ]

        control = lint_tree(fresh())
        if control.count("FAIL"):
            control.show()
            return False, "the unbroken reference copy already FAILs; fix those first"
        missed = []
        for name, breakit, expect in defects:
            d = fresh()
            breakit(d)
            hits = [r for r in lint_tree(d).rows if r[0] == "FAIL" and expect in f"{r[1]}: {r[2]}"]
            if not hits:
                missed.append(name)
        if missed:
            return False, "NOT detected: " + "; ".join(missed)
        return True, f"{len(defects)}/{len(defects)} injected defects were reported as FAIL"
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--deep", action="store_true", help="re-hash images against their sidecars")
    ap.add_argument("--selftest", action="store_true", help="only run the self-test")
    a = ap.parse_args()

    good, msg = selftest()
    R = Rows()
    (R.ok if good else R.fail)("lint self-test", msg)
    if not a.selftest and good:
        R.rows += lint_tree(_pdt.paths()["HTTP_DIR"], a.deep).rows
        R.rows += lint_host().rows
    R.show()
    f, u, p = R.count("FAIL"), R.count("UNKNOWN"), R.count("PASS")
    print(f"\n{p} PASS, {f} FAIL, {u} UNKNOWN" + ("" if not u else "  (UNKNOWN = not checked, not fine)"))
    return 1 if f else 0


sys.exit(main())
