#!/bin/bash
# pxe-lan - make this host answer PXE on a real network: dnsmasq serving
# pxe/ipxe.efi over TFTP.
#
#   pxe-lan [config]      write pxe/dnsmasq.conf and validate it (no root needed)
#   pxe-lan start         start dnsmasq with it        (sudo, unless already root)
#   pxe-lan stop          stop OUR dnsmasq by its pid file
#   pxe-lan --bridge <br> <cidr-range>   authoritative DHCP for a host-only lab
#                         bridge, e.g. --bridge br0 10.42.0.100,10.42.0.199
#
# Default mode is PROXY-DHCP: it hands out no addresses and coexists with the
# LAN's own DHCP server; it only tells UEFI x86-64 PXE clients "your boot file
# is ipxe.efi, from me". HTTP_HOST in config.sh must be this host's address on
# that network (it is baked into ipxe.efi by bin/build-ipxe).
#
# SAFETY: a machine that PXE-boots is only ever wiped if http/machines/<uuid>.cfg
# says MODE=deploy. Unlisted machines boot WinPE to a prompt and are not touched.
#
# Status: --bridge mode is verified end to end inside bin/lab-netns (real DHCP +
# TFTP, VM on a bridge). Proxy mode on a physical LAN is not (PLAN.md, Phase 5).
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

CONF="$PXE_DIR/dnsmasq.conf"
PIDFILE="$STATE_DIR/dnsmasq.pid"
BRIDGE="" RANGE="" ACTION="config"
while (( $# )); do
    case "$1" in
        config|start|stop) ACTION="$1"; shift ;;
        --bridge) BRIDGE="${2:?}"; RANGE="${3:?usage: --bridge <br> <start,end>}"; shift 3 ;;
        -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
        *) die "unknown argument: $1 (try --help)" ;;
    esac
done

# Root already (a real root shell, or "root" inside bin/lab-netns)? Then no sudo.
SUDO="sudo"
if (( EUID == 0 )); then SUDO=""; fi

if [[ "$ACTION" == stop ]]; then
    if [[ -f "$PIDFILE" ]] && pid="$(cat "$PIDFILE")" && [[ "$(ps -o comm= -p "$pid" 2>/dev/null)" == dnsmasq ]]; then
        info "stopping dnsmasq ($pid)"
        kill "$pid" 2>/dev/null || sudo kill "$pid"
        rm -f "$PIDFILE"
    else
        info "dnsmasq (this project): not running"
    fi
    exit 0
fi

need dnsmasq ip python3
[[ -f "$PXE_DIR/ipxe.efi" ]] || die "pxe/ipxe.efi not found; run bin/build-ipxe"
mkdir -p "$STATE_DIR"

if [[ -n "$BRIDGE" ]]; then
    IFACE="$BRIDGE"
    MODE_LINES="dhcp-authoritative
dhcp-range=$RANGE,12h
# Every UEFI x86-64 client gets OUR ipxe.efi, including clients that already
# are iPXE (a NIC option ROM): its embedded script chains to boot.ipxe with the
# machine's identity in the URL, and never asks DHCP for a file name again, so
# there is no loop.
dhcp-boot=tag:efi64,ipxe.efi"
else
    IFACE="${LAN_IF:-$(ip route show default 2>/dev/null | awk '/default/ {print $5; exit}')}"
    [[ -n "$IFACE" ]] || die "cannot detect the LAN interface; set LAN_IF in config.sh"
    CIDR="$(ip -o -f inet addr show "$IFACE" | awk '{print $4; exit}')"
    [[ -n "$CIDR" ]] || die "interface $IFACE has no IPv4 address"
    NET="$(python3 -c "import ipaddress,sys; print(ipaddress.ip_network(sys.argv[1], strict=False).network_address)" "$CIDR")"
    HOSTIP="${CIDR%/*}"
    [[ "$HTTP_HOST" == "$HOSTIP" ]] || warn "config.sh HTTP_HOST=$HTTP_HOST but $IFACE has $HOSTIP: targets on this LAN cannot reach $BASE_URL. Set HTTP_HOST=$HOSTIP, then bin/build-ipxe and bin/serve."
    MODE_LINES="# Proxy-DHCP: answer only the PXE part; the LAN's DHCP server keeps handing out addresses.
dhcp-range=$NET,proxy
pxe-service=tag:efi64,tag:!ipxe,x86-64_EFI,\"PDT network install\",ipxe.efi"
fi

cat > "$CONF" <<DNSMASQ
# Generated by bin/pxe-lan. Do not edit; edit bin/pxe-lan.
interface=$IFACE
bind-interfaces
# No DNS server.
port=0
# The whole DHCP/TFTP conversation per client goes to the log: "never reached
# iPXE" is distinguishable from "iPXE never chained".
log-dhcp
log-facility=$STATE_DIR/dnsmasq.log
# Our own lease file, not the system dnsmasq's.
dhcp-leasefile=$STATE_DIR/dnsmasq.leases
enable-tftp
tftp-root=$PXE_DIR
dhcp-match=set:efi64,option:client-arch,7
dhcp-match=set:efi64,option:client-arch,9
dhcp-match=set:ipxe,175
$MODE_LINES
DNSMASQ

dnsmasq --test -C "$CONF" 2>&1 | sed 's/^/dnsmasq: /' || die "dnsmasq rejected the generated config"
dnsmasq --test -C "$CONF" >/dev/null 2>&1 || die "dnsmasq rejected the generated config"
info "wrote pxe/dnsmasq.conf (interface $IFACE, $([[ -n $BRIDGE ]] && echo "authoritative DHCP $RANGE" || echo proxy-DHCP))"

if [[ "$ACTION" == start ]]; then
    info "starting dnsmasq${SUDO:+ (sudo)}..."
    if in_userns; then
        # Inside bin/lab-netns uid 0 is the only account and changing groups is
        # not permitted, so dnsmasq cannot drop privileges as it normally does.
        # --no-daemon is the mode in which it does not try; we background it
        # and keep the pid ourselves.
        setsid dnsmasq --no-daemon -C "$CONF" >>"$STATE_DIR/dnsmasq.out" 2>&1 &
        echo $! > "$PIDFILE"
        sleep 0.5
        kill -0 "$(cat "$PIDFILE")" 2>/dev/null || die "dnsmasq exited: $(tail -n 3 "$STATE_DIR/dnsmasq.out")"
    else
        $SUDO dnsmasq -C "$CONF" --pid-file="$PIDFILE"
    fi
    info "dnsmasq running, log: ${STATE_DIR#$PDT_ROOT/}/dnsmasq.log. Firewall: allow UDP 67, 69, 4011 and TCP $HTTP_PORT on $IFACE."
else
    info "start it with: bin/pxe-lan start   (needs sudo). Firewall: UDP 67, 69, 4011 and TCP $HTTP_PORT on $IFACE."
fi
