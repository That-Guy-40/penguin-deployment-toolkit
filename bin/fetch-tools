#!/bin/bash
# fetch-tools - download the third-party binaries the boot chain needs, pinned
# by SHA-256, into http/winpe/ and http/tools/. Nothing is vendored in git.
#
#   fetch-tools            fetch + verify wimboot, curl for Windows, wimlib for Windows
#   fetch-tools check      verify what is installed against the pins (no network)
#   fetch-tools virtio     also fetch virtio-win: http/drivers/virtio-w11.wim for the
#                          installed system, http/winpe-drivers/ for WinPE itself
#   fetch-tools winget     also fetch winget (App Installer) and its dependencies into
#                          http/post/winget/, for roles that install apps at first logon
#
# A version string is not an identity (the wimboot v2.9.0 asset was re-uploaded
# with different contents in 2026-05), so every artefact is pinned by hash.
# To move a pin: change URL + hash together, run fetch-tools, then re-verify a
# deployment (bin/test-deploy once it exists; a lab VM run until then).
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
need curl unzip sha256sum

DL="$BUILD_DIR/dl"

# name|url|sha256 of the download
DOWNLOADS=(
"wimboot|https://github.com/ipxe/wimboot/releases/download/v2.9.0/wimboot|5f067ccdc4d084d5bf77b6c853bd0f8402dfc2b4cd1b103d358993ae97fae8e3"
"curl-win64.zip|https://curl.se/windows/dl-8.22.0_1/curl-8.22.0_1-win64-mingw.zip|7f23b039f6ea4197362d4468e1a0e71428201222e1bef3b680d5ef7b2aefb714"
"wimlib-win64.zip|https://wimlib.net/downloads/wimlib-1.14.4-windows-x86_64-bin.zip|6d99e242bfbc6d36fc987d433d63772180551b7f2d8de43e9561535a3e2c16d8"
)
# winget v1.29.380. The hashes are the ones Microsoft publishes next to the
# release (Microsoft.DesktopAppInstaller_8wekyb3d8bbwe.txt, DesktopAppInstaller_Dependencies.txt).
WINGET_REL="https://github.com/microsoft/winget-cli/releases/download/v1.29.380"
WINGET=(
"winget.msixbundle|$WINGET_REL/Microsoft.DesktopAppInstaller_8wekyb3d8bbwe.msixbundle|65dea9c01ce08ee7b763366b27c0e651f97db857c11ca9b9c301826c10092f2e"
"winget-deps.zip|$WINGET_REL/DesktopAppInstaller_Dependencies.zip|ba875afe9d190f61218985ac0292a99d1db710bf93e13c68944ca9d89f0d82d1"
"winget-license.xml|$WINGET_REL/e53e159d00e04f729cc2180cffd1c02e_License1.xml|bcb15118ec47df24e3e6013a7006147c3a15b3a8104ed660fe87c8b4ed01f485"
)
VIRTIO="virtio-win.iso|https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/archive-virtio/virtio-win-0.1.302-1/virtio-win.iso|303f7ae40dad495d6ae474fdc571df58958a4dbc5c37a522d80f9a203867949d"

# installed path (relative to http/)|sha256 of the installed file
INSTALLED=(
"winpe/wimboot|5f067ccdc4d084d5bf77b6c853bd0f8402dfc2b4cd1b103d358993ae97fae8e3"
"tools/curl.exe|57309336350df718d9d3f76694d86a997bf9dc6708ce2d86b658294707572b3c"
"tools/libcurl-x64.dll|10c8871b2188095c26b28767b4f99dc97d0f6fab58a70be47f6679cd9126b13f"
"tools/wimlib-imagex.exe|401bf99d6dec2b749b464183f71d146327ae0856a968c309955f71a0c398a348"
"tools/libwim-15.dll|6480b53d4ecd4423af9e100fe15e3d2c3d114eff33fba07977e46c1ab124342e"
)

# fetch <name|url|sha>: download into $DL unless a verified copy is already there.
fetch() {
    local name url sha
    IFS='|' read -r name url sha <<<"$1"
    mkdir -p "$DL"
    if [[ -f "$DL/$name" ]] && sha256_is "$DL/$name" "$sha"; then
        info "cached   $name"
        return 0
    fi
    info "fetching $name"
    curl -fsSL --retry 3 -o "$DL/$name.part" "$url" || die "download failed: $url"
    if ! sha256_is "$DL/$name.part" "$sha"; then
        local got; got="$(sha256sum "$DL/$name.part" | cut -d' ' -f1)"
        rm -f "$DL/$name.part"
        die "$name: SHA-256 mismatch
  expected $sha
  got      $got
The upstream file changed. Do not use it until the pin is reviewed and updated."
    fi
    mv "$DL/$name.part" "$DL/$name"
}

check() {
    local rc=0 entry path sha
    for entry in "${INSTALLED[@]}"; do
        IFS='|' read -r path sha <<<"$entry"
        if [[ ! -f "$HTTP_DIR/$path" ]]; then
            echo "FAIL     http/$path: missing (run bin/fetch-tools)"; rc=1
        elif sha256_is "$HTTP_DIR/$path" "$sha"; then
            echo "PASS     http/$path matches its pin"
        else
            echo "FAIL     http/$path: does not match its pinned SHA-256"; rc=1
        fi
    done
    return $rc
}

install_all() {
    local d
    for d in "${DOWNLOADS[@]}"; do fetch "$d"; done
    mkdir -p "$HTTP_DIR/winpe" "$HTTP_DIR/tools"
    # A symlink from the v1 layout may be in the way; replace it with the real file.
    rm -f "$HTTP_DIR/winpe/wimboot"
    install -m 0644 "$DL/wimboot" "$HTTP_DIR/winpe/wimboot"
    unzip -q -o -j "$DL/curl-win64.zip" '*/bin/curl.exe' '*/bin/libcurl-x64.dll' -d "$HTTP_DIR/tools"
    unzip -q -o -j "$DL/wimlib-win64.zip" 'wimlib-imagex.exe' 'libwim-15.dll' -d "$HTTP_DIR/tools"
    chmod 0644 "$HTTP_DIR"/tools/*
    check
}

virtio() {
    need 7z
    fetch "$VIRTIO"
    VIRTIO_TMP="$(mktemp -d "$BUILD_DIR/virtio.XXXXXX")"   # global: the EXIT trap outlives this function
    trap 'rm -rf "$VIRTIO_TMP"' EXIT
    7z x -y -o"$VIRTIO_TMP" "$DL/virtio-win.iso" NetKVM/w11/amd64 viostor/w11/amd64 vioscsi/w11/amd64 >/dev/null \
        || die "could not extract the w11/amd64 drivers from virtio-win.iso"
    find "$VIRTIO_TMP" -name '*.pdb' -delete
    "$PDT_ROOT/bin/pack-drivers" "$VIRTIO_TMP" virtio-w11

    # The same drivers for WinPE itself: injected by boot.ipxe when the booting
    # NIC is virtio (winpe-drivers/virtio-net.ipxe) and loaded with drvload.
    local wd="$HTTP_DIR/winpe-drivers" f
    rm -rf "$wd/virtio"
    mkdir -p "$wd/virtio"
    {
        echo '#!ipxe'
        echo '# Generated by bin/fetch-tools virtio, named after the NIC PCI id. WinPE has no virtio drivers:'
        echo '# inject them; deploy.cmd loads the ones listed in pdt-drvload.txt.'
        # Every file of each driver: drvload fails with "file not found" unless
        # everything the .inf names is beside it (netkvm.inf also wants two .exe).
        for f in "$VIRTIO_TMP"/*/w11/amd64/*; do
            case "$f" in *.md|*.pdb) continue ;; esac
            cp "$f" "$wd/virtio/" || die "cannot copy $f"
            echo "initrd --name $(basename "$f") virtio/$(basename "$f") || exit 1"
        done
        echo 'initrd --name pdt-drvload.txt virtio/pdt-drvload.txt || exit 1'
    } > "$wd/01:1a:f4:10:00.ipxe"                 # PCI 1af4:1000, virtio-net (transitional)
    cp "$wd/01:1a:f4:10:00.ipxe" "$wd/01:1a:f4:10:41.ipxe"   # PCI 1af4:1041, virtio-net (modern)
    rm -f "$wd/virtio-net.ipxe"
    printf '%s\r\n' netkvm.inf viostor.inf vioscsi.inf > "$wd/virtio/pdt-drvload.txt"
    chmod 0644 "$wd"/virtio/* "$wd"/*.ipxe
    info "http/winpe-drivers/01:1a:f4:10:{00,41}.ipxe: WinPE-side virtio drivers (netkvm, viostor, vioscsi)"
}

winget() {
    need unzip
    local d
    for d in "${WINGET[@]}"; do fetch "$d"; done
    local wd="$HTTP_DIR/post/winget"
    rm -rf "$wd"; mkdir -p "$wd"
    install -m 0644 "$DL/winget.msixbundle" "$wd/Microsoft.DesktopAppInstaller_8wekyb3d8bbwe.msixbundle"
    install -m 0644 "$DL/winget-license.xml" "$wd/License1.xml"
    # Only the x64 dependencies; one flat directory the first-logon script fetches by name.
    unzip -q -o -j "$DL/winget-deps.zip" 'x64/*.appx' -d "$wd"
    chmod 0644 "$wd"/*
    # The list the installed system downloads, in install order (dependencies first).
    (cd "$wd" && ls *.appx && echo Microsoft.DesktopAppInstaller_8wekyb3d8bbwe.msixbundle) | sed 's/$/\r/' > "$wd/files.txt"
    info "http/post/winget/: $(ls "$wd" | tr '\n' ' ')"
}

case "${1:-all}" in
    all)    install_all ;;
    check)  check ;;
    virtio) virtio ;;
    winget) winget ;;
    -h|--help) sed -n '2,12p' "$0" ;;
    *) die "unknown argument: $1 (try --help)" ;;
esac
