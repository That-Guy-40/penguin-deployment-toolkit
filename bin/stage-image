#!/bin/bash
# stage-image - publish an OS image from the Windows ISO as http/images/<name>.wim
# with a <name>.json sidecar describing exactly what it is.
#
#   stage-image [--index N] [--name base] [--force]
#   stage-image --from-upload <vm|id> --name <role> [--run <run>] [--force]
#   stage-image --from-wim <file.wim> --name <role> [--force]
#
# Either way the image gets a companion http/images/<name>.winre.wim, the
# Windows Recovery Environment that step 45-winre installs when the applied
# image does not carry one (a captured image never does).
#
# The second form publishes an image captured by MODE=capture (step 70-capture
# uploads it to http/uploads/<id>/<run>/capture.wim): it is verified with
# wimlib, moved to http/images/<role>.wim, and given a sidecar recording which
# machine and run it came from. The third does the same for a WIM captured some
# other way (bin/capture-image uses it); the file is moved, not copied.
#
# A single-image install.wim is copied as is. An install.esd, or a WIM with
# several editions, is exported to a single-image LZX WIM with wimlib
# (--index picks the edition; list them with: stage-image --list).
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
need 7z wimlib-imagex python3 sha256sum

INDEX="" NAME="base" FORCE=0 LIST=0 FROM="" RUN="" FROM_WIM="" SOURCE_JSON=""
while (( $# )); do
    case "$1" in
        --index) INDEX="${2:?}"; shift 2 ;;
        --name)  NAME="${2:?}"; shift 2 ;;
        --force) FORCE=1; shift ;;
        --list)  LIST=1; shift ;;
        --from-upload) FROM="${2:?}"; shift 2 ;;
        --run)   RUN="${2:?}"; shift 2 ;;
        --from-wim) FROM_WIM="${2:?}"; shift 2 ;;
        --source-json) SOURCE_JSON="${2:?}"; shift 2 ;;      # used by bin/capture-image
        -h|--help) sed -n '2,23p' "$0"; exit 0 ;;
        *) die "unknown argument: $1" ;;
    esac
done

[[ "$NAME" =~ ^[A-Za-z0-9._-]+$ ]] || die "--name must match [A-Za-z0-9._-]+"

# sidecar <wim> <json> <kind> <source-json>: describe the image next to it.
sidecar() {
    python3 - "$@" <<'PY'
import hashlib, json, os, subprocess, sys, time
wim, sidecar, kind, source = sys.argv[1:5]
info = subprocess.run(["wimlib-imagex", "info", wim, "1"], capture_output=True, text=True, check=True).stdout
field = lambda k: next((l.split(":", 1)[1].strip() for l in info.splitlines() if l.startswith(k + ":")), None)
h = hashlib.sha256()
with open(wim, "rb") as f:
    for chunk in iter(lambda: f.read(1 << 22), b""):
        h.update(chunk)
ver = subprocess.run(["wimlib-imagex", "--version"], capture_output=True, text=True).stdout.splitlines()[0]
# A reference machine stamps itself (post/prepare-capture.cmd):
# "reference <id> run <run> role <role|-> apps <sha256 of the apps list|->".
provenance = None
if kind == "captured":
    import tempfile
    with tempfile.TemporaryDirectory() as tmp:
        r = subprocess.run(["wimlib-imagex", "extract", wim, "1", "/Windows/pdt-image.txt", "--dest-dir=" + tmp, "--no-acls"],
                           capture_output=True, text=True, env={**os.environ, "WIMLIB_IMAGEX_IGNORE_CASE": "1"})
        stamp = open(os.path.join(tmp, "pdt-image.txt")).read().strip() if r.returncode == 0 else None
    if stamp:
        w = stamp.split()
        provenance = {"stamp": stamp}
        for key in ("run", "role", "apps"):
            if key in w and w.index(key) + 1 < len(w) and w[w.index(key) + 1] != "-":
                provenance[key if key != "apps" else "apps_sha256"] = w[w.index(key) + 1]
        if w and w[0] == "reference" and len(w) > 1:
            provenance["reference_machine"] = w[1]
json.dump({
    "file": os.path.basename(wim),
    "size": os.path.getsize(wim),
    "sha256": h.hexdigest(),
    "kind": kind,
    "image_name": field("Name"),
    "edition": field("Edition ID"),
    "build": f'{field("Build")}.{field("Service Pack Build")}',
    "languages": field("Languages"),
    "source": json.loads(source),
    **({"provenance": provenance} if provenance else {}),
    "created": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
    "wimlib": ver,
}, open(sidecar, "w"), indent=2)
print(open(sidecar).read())
PY
}

# winre_from_image <wim> <out>: pull Winre.wim out of an OS image; false if it has none.
winre_from_image() {
    local tmp f; tmp="$(mktemp -d "$BUILD_DIR/winre.XXXXXX")"
    # The file is "winre.wim" in some images and "Winre.wim" in others.
    if WIMLIB_IMAGEX_IGNORE_CASE=1 wimlib-imagex extract "$1" 1 /Windows/System32/Recovery/Winre.wim --dest-dir="$tmp" --no-acls >/dev/null 2>&1 \
        && f="$(find "$tmp" -maxdepth 1 -type f -iname winre.wim | sed -n 1p)" && [[ -s "$f" ]]; then
        mv -f "$f" "$2"; chmod 0644 "$2"; rmdir "$tmp"; return 0
    fi
    rm -rf "$tmp"; return 1
}

mkdir -p "$BUILD_DIR"
# publish_captured <wim> <source-json>: verify a captured image and publish it
# as http/images/$NAME.wim with a sidecar and a companion recovery image.
publish_captured() {
    local cap="$1" source="$2" out="$HTTP_DIR/images/$NAME.wim" listing winre
    [[ "$NAME" != base ]] || die "a captured image needs --name <role> (base is the ISO's image)"
    [[ ! -e "$out" || $FORCE == 1 ]] || die "http/images/$NAME.wim exists (use --force to replace it)"
    info "verifying the captured image (wimlib-imagex verify)..."
    wimlib-imagex verify "$cap" >/dev/null 2>&1 || die "$(basename "$cap") failed verification: damaged or incomplete"
    listing="$(wimlib-imagex dir "$cap" 1)" || die "cannot list $(basename "$cap")"
    grep -qix '/Windows/System32/ntoskrnl.exe' <<<"$listing" || die "$(basename "$cap") does not contain a Windows installation"
    grep -qix '/Windows/System32/Sysprep/Sysprep_succeeded.tag' <<<"$listing" \
        || warn "no Sysprep_succeeded.tag in the image: it was probably not generalized with sysprep, so it is a clone of one machine, not a role image (see REFERENCE=yes, post/prepare-capture.cmd)."
    mkdir -p "$HTTP_DIR/images"
    mv -f "$cap" "$out"
    chmod 0644 "$out"
    # The recovery environment for machines deployed from this image.
    winre="$HTTP_DIR/images/$NAME.winre.wim"
    if winre_from_image "$out" "$winre"; then
        info "$NAME.winre.wim: taken from the captured image"
    elif [[ -f "$HTTP_DIR/images/base.winre.wim" ]]; then
        cp -f "$HTTP_DIR/images/base.winre.wim" "$winre"
        info "$NAME.winre.wim: copied from base.winre.wim (a captured Windows volume carries no Winre.wim)"
    else
        warn "no Winre.wim in the image and no images/base.winre.wim to copy: step 45-winre will fail for this image. Run bin/stage-image first."
    fi
    info "writing sidecar $NAME.json (hashing the image)..."
    sidecar "$out" "$HTTP_DIR/images/$NAME.json" captured "$source"
}

if [[ -n "$FROM_WIM" ]]; then
    [[ -f "$FROM_WIM" ]] || die "no such file: $FROM_WIM"
    publish_captured "$FROM_WIM" "${SOURCE_JSON:-{\"file\": \"$(basename "$FROM_WIM")\"\}}"
    exit 0
fi
if [[ -n "$FROM" ]]; then
    if [[ -f "$VMS_DIR/$FROM/vm.conf" ]]; then vm_load "$FROM"; ID="$VM_UUID"; VMNAME="$FROM"; else ID="${FROM,,}"; VMNAME=""; fi
    UP="$HTTP_DIR/uploads/$ID"
    [[ -d "$UP" ]] || die "nothing uploaded by $FROM ($ID)"
    if [[ -z "$RUN" ]]; then
        # newest run that has a capture.wim
        RUN="$(cd "$UP" && ls -t */capture.wim 2>/dev/null | sed -n '1s|/capture.wim||p')"
    fi
    CAP="$UP/$RUN/capture.wim"
    [[ -n "$RUN" && -f "$CAP" ]] || die "no capture.wim uploaded by $FROM${RUN:+ in run $RUN} (did 70-capture report ok?)"
    publish_captured "$CAP" "{\"machine\": \"$ID\", \"vm\": \"$VMNAME\", \"run\": \"$RUN\", \"via\": \"MODE=capture (dism /capture-image)\"}"
    exit 0
fi

need_iso
SRC="$(iso_path sources/install.wim)"
[[ -n "$SRC" ]] || SRC="$(iso_path sources/install.esd)"
[[ -n "$SRC" ]] || die "no sources/install.wim or install.esd in $ISO_PATH"

OUT_DIR="$HTTP_DIR/images"
OUT="$OUT_DIR/$NAME.wim"
SIDECAR="$OUT_DIR/$NAME.json"
mkdir -p "$OUT_DIR" "$BUILD_DIR"

if [[ -f "$OUT" && -f "$SIDECAR" && $FORCE == 0 && $LIST == 0 ]]; then
    info "http/images/$NAME.wim already staged (use --force to redo)"
    if [[ ! -f "$OUT_DIR/$NAME.winre.wim" ]]; then
        winre_from_image "$OUT" "$OUT_DIR/$NAME.winre.wim" && info "$NAME.winre.wim: extracted from the image" \
            || warn "$NAME.wim contains no Windows/System32/Recovery/Winre.wim"
    fi
    exit 0
fi

WORK="$BUILD_DIR/install.$(basename "$SRC" | sed 's/.*\.//')"
info "extracting $SRC from the ISO ($(( $(iso_size "$SRC") / 1048576 )) MiB)..."
7z e -so "$ISO_PATH" "$SRC" > "$WORK" 2>/dev/null || die "7z failed extracting $SRC"
trap 'rm -f "$WORK"' EXIT

COUNT="$(wimlib-imagex info "$WORK" | awk -F': *' '/^Image Count:/ {print $2}')"
if (( LIST )); then
    wimlib-imagex info "$WORK" | grep -E '^(Index|Name|Description|Edition ID|Build):'
    exit 0
fi
if [[ -z "$INDEX" ]]; then
    (( COUNT == 1 )) || die "the ISO has $COUNT editions; choose one with --index N (see --list)"
    INDEX=1
fi

if [[ "$WORK" == *.wim ]] && (( COUNT == 1 )); then
    mv -f "$WORK" "$OUT"
else
    info "exporting image $INDEX to a single-image LZX WIM..."
    rm -f "$OUT"
    wimlib-imagex export "$WORK" "$INDEX" "$OUT" --compress=LZX || die "wimlib export failed"
fi
chmod 0644 "$OUT"
winre_from_image "$OUT" "$OUT_DIR/$NAME.winre.wim" && info "$NAME.winre.wim: extracted from the image" \
    || warn "$NAME.wim contains no Windows/System32/Recovery/Winre.wim"

info "writing sidecar $NAME.json (hashing the image)..."
sidecar "$OUT" "$SIDECAR" base "{\"iso\": \"$(basename "$ISO_PATH")\", \"path\": \"$SRC\", \"index\": $INDEX}"
