#!/bin/bash
# stage-image - publish an OS image from the Windows ISO as http/images/<name>.wim
# with a <name>.json sidecar describing exactly what it is.
#
#   stage-image [--index N] [--name base] [--force]
#
# A single-image install.wim is copied as is. An install.esd, or a WIM with
# several editions, is exported to a single-image LZX WIM with wimlib
# (--index picks the edition; list them with: stage-image --list).
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
need 7z wimlib-imagex python3 sha256sum
need_iso

INDEX="" NAME="base" FORCE=0 LIST=0
while (( $# )); do
    case "$1" in
        --index) INDEX="${2:?}"; shift 2 ;;
        --name)  NAME="${2:?}"; shift 2 ;;
        --force) FORCE=1; shift ;;
        --list)  LIST=1; shift ;;
        -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
        *) die "unknown argument: $1" ;;
    esac
done

SRC="$(iso_path sources/install.wim)"
[[ -n "$SRC" ]] || SRC="$(iso_path sources/install.esd)"
[[ -n "$SRC" ]] || die "no sources/install.wim or install.esd in $ISO_PATH"

OUT_DIR="$HTTP_DIR/images"
OUT="$OUT_DIR/$NAME.wim"
SIDECAR="$OUT_DIR/$NAME.json"
mkdir -p "$OUT_DIR" "$BUILD_DIR"

if [[ -f "$OUT" && -f "$SIDECAR" && $FORCE == 0 && $LIST == 0 ]]; then
    info "http/images/$NAME.wim already staged (use --force to redo)"
    exit 0
fi

WORK="$BUILD_DIR/install.$(basename "$SRC" | sed 's/.*\.//')"
info "extracting $SRC from the ISO ($(( $(iso_size "$SRC") / 1048576 )) MiB)..."
7z e -so "$ISO_PATH" "$SRC" > "$WORK" 2>/dev/null || die "7z failed extracting $SRC"
trap 'rm -f "$WORK"' EXIT

COUNT="$(wimlib-imagex info "$WORK" | awk -F': *' '/^Image Count:/ {print $2}')"
if (( LIST )); then
    wimlib-imagex info "$WORK" | grep -E '^(Index|Name|Description|Edition ID|Build):'
    exit 0
fi
if [[ -z "$INDEX" ]]; then
    (( COUNT == 1 )) || die "the ISO has $COUNT editions; choose one with --index N (see --list)"
    INDEX=1
fi

if [[ "$WORK" == *.wim ]] && (( COUNT == 1 )); then
    mv -f "$WORK" "$OUT"
else
    info "exporting image $INDEX to a single-image LZX WIM..."
    rm -f "$OUT"
    wimlib-imagex export "$WORK" "$INDEX" "$OUT" --compress=LZX || die "wimlib export failed"
fi
chmod 0644 "$OUT"

info "writing sidecar $NAME.json (hashing the image)..."
python3 - "$OUT" "$SIDECAR" "$ISO_PATH" "$SRC" "$INDEX" <<'PY'
import hashlib, json, os, subprocess, sys, time
wim, sidecar, iso, src, index = sys.argv[1:6]
info = subprocess.run(["wimlib-imagex", "info", wim, "1"], capture_output=True, text=True, check=True).stdout
field = lambda k: next((l.split(":", 1)[1].strip() for l in info.splitlines() if l.startswith(k + ":")), None)
h = hashlib.sha256()
with open(wim, "rb") as f:
    for chunk in iter(lambda: f.read(1 << 22), b""):
        h.update(chunk)
ver = subprocess.run(["wimlib-imagex", "--version"], capture_output=True, text=True).stdout.splitlines()[0]
json.dump({
    "file": os.path.basename(wim),
    "size": os.path.getsize(wim),
    "sha256": h.hexdigest(),
    "kind": "base",
    "image_name": field("Name"),
    "edition": field("Edition ID"),
    "build": f'{field("Build")}.{field("Service Pack Build")}',
    "languages": field("Languages"),
    "source": {"iso": os.path.basename(iso), "path": src, "index": int(index)},
    "created": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
    "wimlib": ver,
}, open(sidecar, "w"), indent=2)
print(open(sidecar).read())
PY
