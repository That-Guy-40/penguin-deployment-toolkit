# sshd_config - written to C:\ProgramData\ssh\sshd_config by post/ssh.ps1 for a
# role with SSH=on. Key-only: no passwords, no keyboard-interactive. Members of
# Administrators authenticate against the one file the role supplies (SSHKEYS);
# other accounts would need %USERPROFILE%\.ssh\authorized_keys (not deployed).
Port 22
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
AuthorizedKeysFile .ssh/authorized_keys
Subsystem sftp sftp-server.exe
@PWSH_SUBSYSTEM@
Match Group administrators
       AuthorizedKeysFile __PROGRAMDATA__/ssh/administrators_authorized_keys
