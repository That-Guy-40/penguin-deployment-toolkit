Windows Registry Editor Version 5.00

; merged into C:\Users\Default\NTUSER.DAT by firstlogon.cmd (SKELREG): every
; profile created afterwards starts with these HKEY_CURRENT_USER values.

[HKEY_CURRENT_USER\Software\PDT]
"SkelFrom"="lab-apps"
"Deployed"=dword:00000001

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced]
"HideFileExt"=dword:00000000
