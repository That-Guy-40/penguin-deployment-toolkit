#!/bin/bash
# config.sh - host-specific settings for this deployment server.
#
# Copy this file to config.sh and edit the copy. Every bin/ script reads it
# through bin/lib.sh; nothing host-specific is hard-coded anywhere else.

# Windows 11 ISO (bring your own). Read by stage-winpe and stage-image.
ISO_PATH=""

# How targets reach this server over HTTP.
#   QEMU user-mode network (the default lab VM):  10.0.2.2
#   Real LAN / bridge:                            this host's address on it
# The pair is baked into pxe/ipxe.efi by build-ipxe; re-run it after a change.
HTTP_HOST="10.0.2.2"
HTTP_PORT="8090"

# Address nginx listens on. Empty = all interfaces.
HTTP_BIND=""

# Lab VM defaults (vm-create copies these into vms/<name>/vm.conf).
VM_MEMORY="4G"
VM_CPUS="4"
VM_DISK_SIZE="64G"

# UEFI firmware. The secboot build with the EMPTY vars template is "Setup
# Mode": Secure Boot capable but not enforcing, so the unsigned pxe/ipxe.efi
# loads. See PLAN.md (Phase 5) for enforcing mode.
OVMF_CODE="/usr/share/OVMF/OVMF_CODE_4M.secboot.fd"
OVMF_VARS_TEMPLATE="/usr/share/OVMF/OVMF_VARS_4M.fd"
IPXE_ROM_DIR="/usr/lib/ipxe/qemu"

# iPXE source revision built by build-ipxe (a commit, not a branch).
IPXE_REF="e0a2ca984f2a5a96c5bc7e7012e23348e9030c24"

# pxe-lan: LAN interface for proxy-DHCP + TFTP. Empty = autodetect from the
# default route.
LAN_IF=""

# Where runtime state lives (nginx pid/logs, beacons.log). Default: ./run
STATE_DIR=""
